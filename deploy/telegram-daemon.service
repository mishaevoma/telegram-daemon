[Unit]
Description=Personal Telegram history daemon
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# User unit: replace this with the absolute path to your installed executable.
ExecStart=%h/.local/bin/tgdaemon run
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
